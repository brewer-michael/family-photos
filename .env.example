# Family Photos — every setting, with defaults. Empty means "not set" (Unraid passes blanks).

# --- Required ---------------------------------------------------------------
# Public address people use, without a path. Used in email links and QR codes (never the
# address a request claims to be for, which a visitor can fake).
PUBLIC_URL=https://photos.example.com
# The family code everyone types (forgiving: case/spacing don't matter). Three words work well.
FAMILY_PASSWORD=blue lake cabin
# Admin password (min 8 chars, must differ from the family code).
ADMIN_PASSWORD=change-me-please

# --- People & site -----------------------------------------------------------
# Where removal requests and failure alerts go. Empty → only shown on the admin page.
ADMIN_EMAIL=
# Shown in copy like "Michael has been told." Default: the site admin
ADMIN_NAME=
# Default: Family Photos
SITE_TITLE=

# --- Email (optional) ----------------------------------------------------------
# Without SMTP_HOST, emails are written as .eml files to $CONFIG_DIR/outbox.
SMTP_HOST=
# 587 (STARTTLS) by default; 465 uses implicit TLS.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Default: "<SITE_TITLE>" <SMTP_USER or ADMIN_EMAIL>
SMTP_FROM=

# --- Advanced -------------------------------------------------------------------
# Keep each converted item's original upload as an admin-only archive.
KEEP_ORIGINALS=true
# Largest single upload, in GiB.
MAX_UPLOAD_GB=50
# Longest video accepted, in minutes.
MAX_VIDEO_MINUTES=120
# ffmpeg threads: auto = max(2, cores/2), or a number.
VIDEO_THREADS=auto
# Which connecting addresses may report the visitor's IP via CF-Connecting-IP / X-Real-IP (used
# to rate-limit sign-in attempts per visitor). Comma-separated IPs/ranges, "private" (loopback,
# 10/8, 172.16/12, 192.168/16, link-local, fc00::/7), "cloudflare" (Cloudflare's published
# ranges) or "none". Default: private, which covers Cloudflare Tunnel or Nginx Proxy Manager
# running on your server or LAN. Use "cloudflare" only if Cloudflare connects straight to this
# app's port, with no Tunnel or NPM in between.
# Cloudflare (orange cloud) -> Nginx Proxy Manager -> this app works with the default too: NPM's
# X-Real-IP is then a Cloudflare server, and next to a CF-Connecting-IP an X-Real-IP that is a
# Cloudflare server or one of the addresses listed here is skipped, so CF-Connecting-IP tells
# visitors apart. Phones and computers at home that reach NPM directly each count on their own.
# Sign-in limits: 10 wrong tries per visitor per 15 minutes. On top of that, after 100 wrong family
# codes (50 admin passwords) in 15 minutes, typing it pauses for browsers that have never signed in
# here. Browsers that have (they carry a signed device cookie) don't share that allowance: they
# have one of their own of the same size, so an attack by strangers can't lock the family out,
# and someone who once had the code can't guess on without limit either. QR links work throughout.
TRUSTED_PROXIES=
# Unraid user/group/umask (applied by docker/entrypoint.sh).
PUID=99
PGID=100
UMASK=022
# Override the HEIF decoder binary (default: heif-dec, else heif-convert).
HEIF_DEC_BIN=
# Override tool paths (defaults: exiftool from PATH/vendored, ffmpeg, ffprobe).
EXIFTOOL_BIN=
FFMPEG_BIN=
FFPROBE_BIN=

# --- Set by the Dockerfile (change only for local development) -------------------
PORT=3000
HOST=0.0.0.0
# The Docker image sets CONFIG_DIR=/config and PHOTOS_DIR=/photos. Default when run locally:
# ./data/config and ./data/photos
#CONFIG_DIR=/config
#PHOTOS_DIR=/photos
# adapter-node: trust X-Forwarded-Proto from your proxy (server.js defaults to this).
PROTOCOL_HEADER=x-forwarded-proto
# Must exceed the 50 MiB tus chunk size.
BODY_SIZE_LIMIT=64M
UV_THREADPOOL_SIZE=8
# Built worker entry (default ./build-worker/worker.js).
WORKER_ENTRY=
